---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
---

<Layout title="The MUSS | Campus Sports Society">
  <Navbar />
  <Hero />

  <!-- Placeholder sections so you can keep building -->
  <section id="events" class="min-h-screen bg-zinc-950 flex items-center justify-center">
    <div class="text-center">
      <h2 class="text-4xl md:text-6xl font-bold mb-4">Events</h2>
      <p class="text-white/60">Coming soon...</p>
    </div>
  </section>

  <section id="teams" class="min-h-screen bg-black flex items-center justify-center">
    <div class="text-center">
      <h2 class="text-4xl md:text-6xl font-bold mb-4">Teams</h2>
      <p class="text-white/60">Coming soon...</p>
    </div>
  </section>

  <section id="join" class="min-h-screen bg-zinc-950 flex items-center justify-center">
    <div class="text-center max-w-2xl px-4">
      <h2 class="text-4xl md:text-6xl font-bold mb-6">Ready to Join?</h2>
      <p class="text-xl text-white/70 mb-8">
        Wear the colors. Bring the noise. Be part of something bigger.
      </p>
      <a
        href="#"
        class="inline-block px-10 py-4 bg-red-600 hover:bg-red-700 text-white font-bold text-lg rounded-full transition-all"
      >
        Become a Member
      </a>
    </div>
  </section>
</Layout>