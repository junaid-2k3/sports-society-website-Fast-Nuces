---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

// Row 1: Faculty Leadership Posters
import facultyHeadImg from "../assets/Core_team_sports_soceity/faculty_head.PNG";
import facultyAdvisorImg from "../assets/Core_team_sports_soceity/faculty_advisor.jpg";

// Row 2: Executive Board & Student Advisor Posters
import presidentImg from "../assets/Core_team_sports_soceity/President.PNG";
import vicePresidentImg from "../assets/Core_team_sports_soceity/vice_president.PNG";
import generalSecretaryImg from "../assets/Core_team_sports_soceity/General_secretary.PNG";
import studentAdvisorImg from "../assets/Core_team_sports_soceity/Student_advisor.jpg";

// Row 3+: All Discipline & Management Heads Posters
import headCricketImg from "../assets/Core_team_sports_soceity/Head_cricket.PNG";
import headFutsalImg from "../assets/Core_team_sports_soceity/head_futsal.PNG";
import headBadmintonImg from "../assets/Core_team_sports_soceity/badminton_head.jpg";
import headTableTennisImg from "../assets/Core_team_sports_soceity/head_table_tennis.PNG";
import headVolleyballImg from "../assets/Core_team_sports_soceity/head_volleyBall.PNG";
import headChessImg from "../assets/Core_team_sports_soceity/head_chess.PNG";
import headCarromImg from "../assets/Core_team_sports_soceity/head_carrom_borad.PNG";
import headLudoImg from "../assets/Core_team_sports_soceity/head_Ludo.PNG";
import headTugOfWarImg from "../assets/Core_team_sports_soceity/head_tugOfwar.PNG";
import headFinanceImg from "../assets/Core_team_sports_soceity/head_finance.PNG";
import headLogisticsImg from "../assets/Core_team_sports_soceity/head_logistics.PNG";
import headEquipmentImg from "../assets/Core_team_sports_soceity/Head_equipment.PNG";
import headDecorImg from "../assets/Core_team_sports_soceity/head_decor.PNG";
import headGraphicsImg from "../assets/Core_team_sports_soceity/head_graphics.PNG";
import headOutreachImg from "../assets/Core_team_sports_soceity/head_outReach.PNG";
import headSocialMediaImg from "../assets/Core_team_sports_soceity/head_social_media.PNG";
import laraibImg from "../assets/Core_team_sports_soceity/Laraib.png";

const row1Faculty = [
  {
    name: "Faculty Head",
    role: "Faculty Head & Director of Sports",
    image: facultyHeadImg,
    badge: "FACULTY LEADERSHIP",
  },
  {
    name: "Faculty Advisor",
    role: "Faculty Advisor & Patron",
    image: facultyAdvisorImg,
    badge: "FACULTY LEADERSHIP",
  },
];

const row2Executive = [
  {
    name: "President",
    role: "President, Sports Society",
    image: presidentImg,
    badge: "EXECUTIVE BOARD",
  },
  {
    name: "Vice President",
    role: "Vice President, Sports Society",
    image: vicePresidentImg,
    badge: "EXECUTIVE BOARD",
  },
  {
    name: "General Secretary",
    role: "General Secretary, Sports Society",
    image: generalSecretaryImg,
    badge: "EXECUTIVE BOARD",
  },
  {
    name: "Student Advisor",
    role: "Senior Student Advisor",
    image: studentAdvisorImg,
    badge: "EXECUTIVE BOARD",
  },
];

const row3Heads = [
  { name: "Head of Cricket", role: "Discipline Lead - Cricket", image: headCricketImg, badge: "DISCIPLINE HEAD" },
  { name: "Head of Futsal", role: "Discipline Lead - Futsal", image: headFutsalImg, badge: "DISCIPLINE HEAD" },
  { name: "Head of Badminton", role: "Discipline Lead - Badminton", image: headBadmintonImg, badge: "DISCIPLINE HEAD" },
  { name: "Head of Table Tennis", role: "Discipline Lead - Table Tennis", image: headTableTennisImg, badge: "DISCIPLINE HEAD" },
  { name: "Head of Volleyball", role: "Discipline Lead - Volleyball", image: headVolleyballImg, badge: "DISCIPLINE HEAD" },
  { name: "Head of Chess", role: "Discipline Lead - Chess", image: headChessImg, badge: "DISCIPLINE HEAD" },
  { name: "Head of Carrom Board", role: "Discipline Lead - Carrom", image: headCarromImg, badge: "DISCIPLINE HEAD" },
  { name: "Head of Ludo", role: "Discipline Lead - Ludo", image: headLudoImg, badge: "DISCIPLINE HEAD" },
  { name: "Head of Tug of War", role: "Discipline Lead - Tug of War", image: headTugOfWarImg, badge: "DISCIPLINE HEAD" },
  { name: "Head of Finance", role: "Management Lead - Finance", image: headFinanceImg, badge: "MANAGEMENT HEAD" },
  { name: "Head of Logistics", role: "Operations Lead - Logistics", image: headLogisticsImg, badge: "MANAGEMENT HEAD" },
  { name: "Head of Equipment", role: "Operations Lead - Equipment", image: headEquipmentImg, badge: "MANAGEMENT HEAD" },
  { name: "Head of Decor", role: "Creative Lead - Decor & Ambience", image: headDecorImg, badge: "CREATIVE HEAD" },
  { name: "Head of Graphics", role: "Media Lead - Graphic Design", image: headGraphicsImg, badge: "MEDIA HEAD" },
  { name: "Head of Outreach", role: "PR Lead - Campus Outreach", image: headOutreachImg, badge: "PR HEAD" },
  { name: "Head of Social Media", role: "Media Lead - Social Media", image: headSocialMediaImg, badge: "MEDIA HEAD" },
  { name: "Joint Secretary / Lead", role: "Executive Cabinet Lead", image: laraibImg, badge: "EXECUTIVE LEAD" },
];
---

<Layout title="Core Team & Society Leadership Posters | FAST NUCES Peshawar Sports Society">
  <Navbar />
  <main class="pt-28 pb-24 bg-black text-white">
    
    <!-- Hero Header -->
    <div class="relative py-16 bg-gradient-to-b from-red-950/60 via-zinc-950 to-black border-b border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="px-4 py-1.5 bg-red-600 text-white font-bebas text-sm tracking-widest uppercase rounded-full shadow-lg">
          OFFICIAL SOCIETY HIERARCHY
        </span>
        <h1 class="font-bebas text-6xl sm:text-8xl tracking-tight text-white mt-4">
          MEET OUR <span class="text-red-600">CORE TEAM</span>
        </h1>
        <p class="max-w-3xl mx-auto text-zinc-300 text-base sm:text-lg mt-4">
          Official leadership posters for the FAST NUCES Peshawar Sports Society — structured from top faculty mentors down to discipline and management heads.
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

      <!-- ROW 1: FACULTY HEAD & FACULTY ADVISOR -->
      <div>
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-xs font-bold uppercase tracking-widest text-red-500 font-mono">1ST ROW • TOP LEADERSHIP</span>
          <h2 class="font-bebas text-4xl sm:text-6xl text-white tracking-wide mt-1">FACULTY HEAD & ADVISOR</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {row1Faculty.map((member) => (
            <div class="group relative rounded-3xl overflow-hidden bg-zinc-950 border border-red-600/70 shadow-2xl shadow-red-950/50 hover:-translate-y-2 transition-all duration-500 flex flex-col">
              <div class="relative w-full overflow-hidden bg-black">
                <Image
                  src={member.image}
                  alt={member.name}
                  class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent"></div>
                
                <span class="absolute top-4 left-4 px-3 py-1 bg-red-600/90 backdrop-blur-md text-white rounded-full text-[10px] font-extrabold uppercase tracking-widest">
                  {member.badge}
                </span>
              </div>

              <div class="p-6 bg-zinc-950 border-t border-zinc-800 text-center">
                <h3 class="font-bebas text-3xl text-white tracking-wide group-hover:text-red-500 transition-colors">
                  {member.name}
                </h3>
                <span class="text-xs font-bold text-red-400 uppercase tracking-widest mt-1 block">
                  {member.role}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ROW 2: PRESIDENT, VP, GENERAL SECRETARY & STUDENT ADVISOR -->
      <div>
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-xs font-bold uppercase tracking-widest text-red-500 font-mono">2ND ROW • EXECUTIVE BOARD & ADVISOR</span>
          <h2 class="font-bebas text-4xl sm:text-6xl text-white tracking-wide mt-1">PRESIDENT, VP, GEN SEC & STUDENT ADVISOR</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {row2Executive.map((member) => (
            <div class="group relative rounded-3xl overflow-hidden bg-zinc-950 border border-zinc-800 hover:border-red-600/70 shadow-xl hover:-translate-y-2 transition-all duration-500 flex flex-col">
              <div class="relative w-full overflow-hidden bg-black">
                <Image
                  src={member.image}
                  alt={member.name}
                  class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent"></div>
                
                <span class="absolute top-4 left-4 px-3 py-1 bg-red-600/90 backdrop-blur-md text-white rounded-full text-[10px] font-extrabold uppercase tracking-widest">
                  {member.badge}
                </span>
              </div>

              <div class="p-6 bg-zinc-950 border-t border-zinc-800 text-center">
                <h3 class="font-bebas text-3xl text-white tracking-wide group-hover:text-red-500 transition-colors">
                  {member.name}
                </h3>
                <span class="text-xs font-bold text-red-400 uppercase tracking-widest mt-1 block">
                  {member.role}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ROW 3+: ALL THE HEADS -->
      <div>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-red-500 font-mono">3RD ROW ONWARDS • DISCIPLINE & EVENT HEADS</span>
          <h2 class="font-bebas text-4xl sm:text-6xl text-white tracking-wide mt-1">ALL HEADS & COORDINATORS</h2>
          <p class="text-zinc-400 text-sm mt-2">Captains and department heads leading tournament execution across campus.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {row3Heads.map((member) => (
            <div class="group relative rounded-2xl overflow-hidden bg-zinc-950 border border-zinc-800 hover:border-red-600/70 shadow-lg hover:-translate-y-1.5 transition-all duration-500 flex flex-col">
              <div class="relative w-full overflow-hidden bg-black">
                <Image
                  src={member.image}
                  alt={member.name}
                  class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent"></div>
                
                <span class="absolute top-3 left-3 px-2.5 py-0.5 bg-red-600/90 backdrop-blur-md text-white rounded-full text-[9px] font-extrabold uppercase tracking-widest">
                  {member.badge}
                </span>
              </div>

              <div class="p-4 bg-zinc-950 border-t border-zinc-800/80 text-center">
                <h4 class="font-bebas text-2xl text-white tracking-wide group-hover:text-red-500 transition-colors">
                  {member.name}
                </h4>
                <span class="text-[11px] font-bold text-red-400 uppercase tracking-wider mt-0.5 block">
                  {member.role}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

  </main>
  <Footer />
</Layout>
