  {
    id: "jenga",
    name: "Jenga",
    category: "MORE GAMES",
    subCategory: "Skill & Precision",
    tagline: "Tower of Tension",
    dates: "5 Oct – 8 Oct 2026",
    players: "1 Player",
    registrationFee: "200 PKR",
    image: jengaImg,
    badge: "MALE / FEMALE",
    rules: [
      { label: "Goal", detail: "Pull wooden blocks from the tower without causing it to crash." },
      { label: "Turn Execution", detail: "Carefully remove 1 block from any level below the top completed story." },
      { label: "Stacking", detail: "Place block on the top level at right angles to the blocks below it." },
      { label: "Single Hand", detail: "Only one hand may be used to touch or test blocks at any time." },
      { label: "Tower Fall", detail: "The player who causes the tower to collapse loses the match." },
    ],
  },
  {
    id: "darts",
    name: "Darts",
    category: "MORE GAMES",
    subCategory: "Target Sport",
    tagline: "Bullseye Master",
    dates: "5 Oct – 8 Oct 2026",
    players: "1 Player",
    registrationFee: "150 PKR",
    image: dartsImg,
    badge: "MALE / FEMALE",
    rules: [
      { label: "Format", detail: "1 Player individual precision target game." },
      { label: "Oche Line", detail: "Throws must be taken from behind the official throw line (oche)." },
      { label: "Turn Scoring", detail: "3 darts thrown per turn. Score recorded based on board sector rings." },
      { label: "Target Sectors", detail: "Inner Bullseye = 50 pts, Outer Bullseye = 25 pts, Doubles/Triples as marked." },
      { label: "Winner", detail: "Player accumulating the highest score over specified rounds wins." },
    ],
  },
  {
    id: "dodgeball",
    name: "Dodgeball",
    category: "MORE GAMES",
    subCategory: "Team Action",
    tagline: "Duck & Dodge",
    dates: "5 Oct – 8 Oct 2026",
    players: "6–12 Players",
    registrationFee: "1,000 PKR",
    image: dodgeballImg,
    badge: "MALE",
    rules: [
      { label: "Teams & Opening Rush", detail: "2 teams (6-12 players). Equal balls along center line; teams rush on whistle." },
      { label: "Hits & Elimination", detail: "Hit directly below neck by thrown ball = eliminated." },
      { label: "Catching Throws", detail: "Catching opponent thrown ball eliminates thrower AND brings 1 eliminated teammate back." },
      { label: "Blocking", detail: "May block incoming ball with held ball; if knocked loose & hits ground, blocker is out." },
      { label: "Match Winner", detail: "Best-of-three rounds. Round ends when all opposing players are eliminated." },
    ],
  },
  {
    id: "sequence",
    name: "Sequence",
    category: "MORE GAMES",
    subCategory: "Board Strategy",
    tagline: "5-in-a-Row Strategy",
    dates: "5 Oct – 8 Oct 2026",
    players: "2–12 Players (Team or Indiv)",
    registrationFee: "200 PKR / person",
    image: sequenceImg,
    badge: "MALE / FEMALE",
    rules: [
      { label: "Objective", detail: "5 chips in a row (horizontal, vertical, diagonal) = 1 Sequence." },
      { label: "Win Condition", detail: "2 Sequences to win for 2 players/teams; 1 Sequence for 3 players/teams." },
      { label: "Turn Flow", detail: "Play card -> place matching chip on board -> draw new card (must draw before next turn)." },
      { label: "Jacks Ability", detail: "Two-eyed Jack: place chip anywhere. One-eyed Jack: remove opponent chip." },
      { label: "Corners & Fair Play", detail: "4 corners are free for everyone. No coaching or signaling in team play." },
    ],
  },
  {
    id: "musicalchairs",
    name: "Musical Chairs",
    category: "MORE GAMES",
    subCategory: "Fun Event",
    tagline: "Last Chair Standing",
    dates: "5 Oct – 8 Oct 2026",
    players: "Individual",
    registrationFee: "100 PKR / person",
    image: musicalChairsImg,
    badge: "MALE / FEMALE",
    rules: [
      { label: "Setup", detail: "Chairs arranged facing outwards in a circle, with 1 fewer chair than total players." },
      { label: "Music & Movement", detail: "Players walk around chairs while music plays." },
      { label: "Elimination", detail: "When music stops, players must sit immediately. Player left standing is eliminated." },
      { label: "Final Round", detail: "1 chair removed each round. Final 2 players compete for 1 remaining chair." },
    ],
  },
  {
    id: "carrom",
    name: "Carrom",
    category: "MORE GAMES",
    subCategory: "Indoor Board",
    tagline: "Striker Champions",
    dates: "5 Oct – 8 Oct 2026",
    players: "2 Players Team",
    registrationFee: "500 PKR per person",
    image: carromImg,
    badge: "MALE / FEMALE",
    rules: [
      { label: "Format", detail: "2 Players team match on standard carrom board." },
      { label: "Striking", detail: "Pocket carrom men coins using official striker." },
      { label: "Queen Covering", detail: "Red queen must be covered by pocketing a carrom piece on the immediate next strike." },
      { label: "Fouls", detail: "Striker pocketed or coins knocked off board incurs penalty coin return." },
    ],
  },
