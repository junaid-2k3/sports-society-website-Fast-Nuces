---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

import cricketImg from "../assets/sports_posters/criceket.jpg";
import futsalImg from "../assets/sports_posters/futsal.jpg";
import badmintonImg from "../assets/sports_posters/badminton.jpg";
import ttImg from "../assets/sports_posters/table_tennis.jpg";
import volleyballImg from "../assets/sports_posters/volleyball.jpg";

import unoImg from "../assets/sports_posters/uno.jpeg";
import mafiaImg from "../assets/sports_posters/mafia.jpeg";
import jengaImg from "../assets/sports_posters/jenga.jpeg";
import dartsImg from "../assets/sports_posters/darts.jpg";
import dodgeballImg from "../assets/sports_posters/dodgeball.jpg";
import sequenceImg from "../assets/sports_posters/sequence.jpeg";
import musicalChairsImg from "../assets/sports_posters/musical_chairs.jpg";
import carromImg from "../assets/sports_posters/carrom.jpg";

const sportsData = [
  {
    id: "cricket",
    name: "Cricket",
    category: "Main Sport",
    subCategory: "Outdoor",
    tagline: "The Fastian XI",
    dates: "5 Oct – 8 Oct 2026",
    players: "9 Players (8 playing, 1 substitute)",
    registrationFee: "5,500 PKR",
    image: cricketImg,
    badge: "MALE",
    rules: [
      { label: "Squad & Team", detail: "9 Players total per squad (8 playing, 1 substitute). List submitted before tournament." },
      { label: "Ball & Overs", detail: "Played with Tennis Ball. 5 overs per side in group stages; 6 to 8 overs in semifinals/finals." },
      { label: "Bowler Limits", detail: "Max 2 overs per bowler in a 5-over match." },
      { label: "Bowling Action", detail: "Proper bowling action required; direct underarm bowling is not allowed." },
      { label: "Bouncers & Wides", detail: "Bouncers above shoulder height called wide. Wide ball = +1 run and extra delivery." },
      { label: "Ties & Super Over", detail: "Tie decided by Super Over. If still tied, team with most boundaries wins." },
