      { label: "Service Rule", detail: "Service behind end line and above table surface. Service toss vertical at least 16cm." },
      { label: "Faults & Fouls", detail: "Touching table with free hand or moving table during rally loses point." },
      { label: "Conduct & Reporting", detail: "Report 15 minutes prior. No outside coaching allowed during matches." },
    ],
  },
  {
    id: "volleyball",
    name: "Volleyball",
    category: "Main Sport",
    subCategory: "Outdoor Arena",
    tagline: "Spikers Elite",
    dates: "5 Oct – 8 Oct 2026",
    players: "8 Players (6 playing, 2 substitutes)",
    registrationFee: "3,500 PKR",
    image: volleyballImg,
    badge: "MALE",
    rules: [
      { label: "Match Format", detail: "Best 2 out of 3 sets or best 3 out of 5 sets. Rally point scoring system." },
      { label: "Set Scoring", detail: "25 points per set with a minimum lead of 2 points." },
      { label: "Knockout Matches", detail: "Simple qualifying matches played as single set to 21 points." },
      { label: "Touch & Net Rules", detail: "Maximum 3 touches per side. Net touches, catching, or holding ball lose point." },
      { label: "Serving & Out", detail: "Serve must clear net into opponent court. Out of bounds gives point to opposing team." },
    ],
  },
  {
    id: "uno",
    name: "UNO",
    category: "MORE GAMES",
    subCategory: "Card Game",
    tagline: "Wild Card Showdown",
    dates: "5 Oct – 8 Oct 2026",
    players: "4–6 Players per table",
    registrationFee: "200 PKR / person",
    image: unoImg,
    badge: "MALE / FEMALE",
    rules: [
      { label: "Format & Setup", detail: "Individual game; 4–6 players per table. 7 cards dealt at start." },
      { label: "Gameplay", detail: "Match top discard card by colour, number, or symbol. If unable, draw 1 card." },
      { label: "UNO Call", detail: "Must call 'UNO' when holding 1 card. If caught before next player turn, draw 2 penalty cards." },
      { label: "Action Cards", detail: "Skip, Reverse, Draw Two (+2), Wild, Wild Draw Four (+4)." },
      { label: "Strict Regulations", detail: "NO stacking +2/+4 cards. NO house rules (no jump-in, no 7-0)." },
