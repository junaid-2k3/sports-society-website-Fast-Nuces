---

<Layout title="Sports Cards & Official Tournament Rules | FAST NUCES Peshawar Sports Society">
  <Navbar />
  <main class="pt-28 pb-24 bg-black text-white">
    
    <!-- Hero Header -->
    <div class="relative py-16 bg-gradient-to-b from-red-950/60 via-zinc-950 to-black border-b border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="px-4 py-1.5 bg-red-600 text-white font-bebas text-sm tracking-widest uppercase rounded-full shadow-lg">
          SPORTS WEEK 2026 • 5 – 8 OCTOBER
        </span>
        <h1 class="font-bebas text-6xl sm:text-8xl tracking-tight text-white mt-4">
          SPORTS CARDS & <span class="text-red-600">OFFICIAL RULES</span>
        </h1>
        <p class="max-w-3xl mx-auto text-zinc-300 text-base sm:text-lg mt-4 mb-6">
          Explore the official 13 sports disciplines included in the FAST NUCES Peshawar Sports Week. Click any card to view complete match rules or register now!
        </p>

        <a
          href="https://forms.gle/MqXNNPWHjV4oW2bP7"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm tracking-wider uppercase rounded-full shadow-lg shadow-red-950/80 hover:scale-105 transition-all"
        >
          <span>Register Now For Sports Week</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Sports Cards Grid Container -->
    <div id="rules" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
      
      <!-- MAIN SPORTS SECTION -->
      <div>
        <div class="flex items-center gap-3 mb-8 border-b border-zinc-800 pb-4">
          <span class="w-3 h-3 rounded-full bg-red-600"></span>
          <h2 class="font-bebas text-4xl sm:text-5xl text-white tracking-wide">
            MAIN SPORTS <span class="text-zinc-500 text-2xl font-mono">(5 DISCIPLINES)</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sportsData.filter(s => s.category === "Main Sport").map((sport) => (
            <div 
              class="sport-card group cursor-pointer relative rounded-3xl overflow-hidden bg-zinc-950 border border-zinc-800 hover:border-red-600/80 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-red-950/60 flex flex-col justify-between"
              data-sport={JSON.stringify(sport)}
            >
              <!-- Poster Image -->
              <div class="relative h-64 w-full overflow-hidden">
                <Image
                  src={sport.image}
                  alt={sport.name}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 filter brightness-90 group-hover:brightness-100"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
                
                <span class="absolute top-4 left-4 px-3 py-1 bg-red-600/90 backdrop-blur-md text-white rounded-full text-[10px] font-extrabold uppercase tracking-widest">
                  {sport.badge}
                </span>

                <span class="absolute top-4 right-4 px-3 py-1 bg-black/80 text-zinc-300 border border-zinc-700 rounded-full text-[10px] font-bold uppercase tracking-widest">
                  {sport.subCategory}
                </span>
              </div>

              <!-- Content -->
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-1">
                    <h3 class="font-bebas text-4xl text-white tracking-wide group-hover:text-red-500 transition-colors">
                      {sport.name}
                    </h3>
                    <span class="text-xs font-bold text-red-400 uppercase tracking-widest">{sport.tagline}</span>
                  </div>

                  <p class="text-xs text-zinc-400 font-mono mt-2">
                    👥 {sport.players}
                  </p>

                  <p class="text-xs text-zinc-400 font-mono mt-1">
                    💰 Registration: <strong class="text-red-400">{sport.registrationFee}</strong>
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-zinc-800 flex items-center justify-between gap-2">
                  <span class="text-xs font-extrabold uppercase tracking-widest text-zinc-300 group-hover:text-red-400 transition-colors flex items-center gap-1">
                    <span>Rules</span>
                    <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </span>

                  <a
                    href="https://forms.gle/MqXNNPWHjV4oW2bP7"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="register-link px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs tracking-wider uppercase rounded-xl transition-all shadow-md shadow-red-950/60 flex items-center gap-1.5"
                  >
                    <span>Register Now</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              </div>

            </div>
          ))}
        </div>
      </div>

      <!-- MORE GAMES SECTION -->
      <div>
        <div class="flex items-center gap-3 mb-8 border-b border-zinc-800 pb-4">
          <span class="w-3 h-3 rounded-full bg-red-600"></span>
          <h2 class="font-bebas text-4xl sm:text-5xl text-white tracking-wide">
            MORE GAMES <span class="text-zinc-500 text-2xl font-mono">(8 FUN & STRATEGY GAMES)</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {sportsData.filter(s => s.category === "MORE GAMES").map((sport) => (
            <div 
              class="sport-card group cursor-pointer relative rounded-3xl overflow-hidden bg-zinc-950 border border-zinc-800 hover:border-red-600/80 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-red-950/60 flex flex-col justify-between"
              data-sport={JSON.stringify(sport)}
            >
              <!-- Poster Image -->
              <div class="relative h-52 w-full overflow-hidden">
                <Image
                  src={sport.image}
                  alt={sport.name}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 filter brightness-90 group-hover:brightness-100"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
                
                <span class="absolute top-3 left-3 px-2.5 py-0.5 bg-red-600/90 backdrop-blur-md text-white rounded-full text-[10px] font-extrabold uppercase tracking-widest">
                  {sport.badge}
                </span>
              </div>

              <!-- Content -->
              <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="font-bebas text-3xl text-white tracking-wide group-hover:text-red-500 transition-colors">
                    {sport.name}
                  </h3>
                  <span class="text-[11px] font-bold text-red-400 uppercase tracking-widest block mb-2">{sport.tagline}</span>

                  <p class="text-[11px] text-zinc-400 font-mono">
                    👥 {sport.players}
                  </p>
                  <p class="text-[11px] text-zinc-400 font-mono mt-0.5">
                    💰 Fee: <strong class="text-red-400">{sport.registrationFee}</strong>
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-zinc-800/80 flex items-center justify-between gap-2">
                  <span class="text-[11px] font-extrabold uppercase tracking-wider text-zinc-300 group-hover:text-red-400 transition-colors">
                    Rules
                  </span>

                  <a
                    href="https://forms.gle/MqXNNPWHjV4oW2bP7"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="register-link px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white font-extrabold text-[10px] tracking-wider uppercase rounded-lg transition-all shadow-md shadow-red-950/60 flex items-center gap-1"
                  >
                    <span>Register</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              </div>

            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- RULES MODAL POPUP -->
    <div id="rules-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-black/85 backdrop-blur-md transition-all">
      <div class="relative w-full max-w-3xl max-h-[90vh] bg-zinc-950 border border-red-600/60 rounded-3xl shadow-2xl overflow-hidden flex flex-col">
        
        <!-- Modal Header -->
        <div class="p-6 bg-gradient-to-r from-red-950/90 via-zinc-900 to-zinc-950 border-b border-zinc-800 flex items-start justify-between">
          <div>
            <span id="modal-dates" class="text-xs font-bold uppercase tracking-widest text-red-400 font-mono block">
              5 OCT – 8 OCT 2026
            </span>
            <h3 id="modal-title" class="font-bebas text-4xl sm:text-5xl text-white tracking-wide mt-1">
              SPORT RULES
            </h3>
            <div class="flex items-center gap-3 mt-1 text-xs text-zinc-300 font-mono">
              <span id="modal-players">👥 Players</span>
              <span>•</span>
              <span id="modal-fee" class="text-red-400">💰 Fee</span>
            </div>
          </div>

          <button 
            id="close-modal" 
            type="button" 
            class="p-2.5 rounded-full bg-zinc-900 text-zinc-400 hover:text-white hover:bg-red-600 transition-all focus:outline-none"
            aria-label="Close rules modal"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Modal Body (Rules List) -->
        <div id="modal-rules-container" class="p-6 sm:p-8 overflow-y-auto space-y-4 max-h-[60vh] bg-zinc-950">
          <!-- Dynamic rules inserted via JavaScript -->
        </div>

        <!-- Modal Footer -->
        <div class="p-4 bg-zinc-900 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-400 font-mono">
          <span>FAST NUCES Peshawar Sports Society</span>
          
          <div class="flex items-center gap-3">
            <a 
              href="https://forms.gle/MqXNNPWHjV4oW2bP7"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2 rounded-full bg-red-600 hover:bg-red-700 text-white font-extrabold uppercase tracking-wider transition-all shadow-md shadow-red-950/60 flex items-center gap-1.5"
            >
              <span>Register Now</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            
            <button 
              id="modal-close-btn"
              class="px-4 py-2 rounded-full bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-bold uppercase tracking-wider transition-all"
            >
              Close
            </button>
          </div>
        </div>

      </div>
    </div>

  </main>
  <Footer />
</Layout>

<script>
  const cards = document.querySelectorAll(".sport-card");
  const modal = document.getElementById("rules-modal");
  const closeModal = document.getElementById("close-modal");
  const modalCloseBtn = document.getElementById("modal-close-btn");

  const modalTitle = document.getElementById("modal-title");
  const modalDates = document.getElementById("modal-dates");
  const modalPlayers = document.getElementById("modal-players");
  const modalFee = document.getElementById("modal-fee");
  const rulesContainer = document.getElementById("modal-rules-container");

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const dataRaw = card.getAttribute("data-sport");
      if (!dataRaw) return;

      const data = JSON.parse(dataRaw);

      if (modalTitle) modalTitle.textContent = data.name + " Official Rules";
      if (modalDates) modalDates.textContent = "SPORTS WEEK • " + data.dates;
      if (modalPlayers) modalPlayers.textContent = "👥 " + data.players;
      if (modalFee) modalFee.textContent = "💰 Reg Fee: " + data.registrationFee;

      if (rulesContainer) {
        rulesContainer.innerHTML = "";
        data.rules.forEach((rule: { label: string; detail: string }) => {
          const div = document.createElement("div");
          div.className = "p-4 rounded-xl bg-zinc-900/80 border border-zinc-800";
          div.innerHTML = `
            <span class="text-xs font-bold uppercase tracking-wider text-red-400 block font-mono mb-1">
              • ${rule.label}
            </span>
            <p class="text-xs sm:text-sm text-zinc-200 leading-relaxed">
              ${rule.detail}
            </p>
          `;
          rulesContainer.appendChild(div);
        });
      }

      modal?.classList.remove("hidden");
      modal?.classList.add("flex");
    });
  });

  const hideModal = () => {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
  };

  closeModal?.addEventListener("click", hideModal);
  modalCloseBtn?.addEventListener("click", hideModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) hideModal();
  });
</script>
