      { label: "Extra Time & Tiebreaker", detail: "Extra Time: 2 halves of 3 mins. Tiebreaker: Penalty shootout (5 kicks each, then sudden death)." },
      { label: "Kick-Ins & Restart", detail: "Kick-ins instead of throw-ins (within 4 seconds). Goalkeeper clearance by throw only." },
      { label: "Goalkeeper Restrictions", detail: "Touches ball once per possession, releases within 4s, no hands on teammate back-pass." },
      { label: "Accumulated Fouls", detail: "After 5 accumulated fouls, opponent receives direct free kick from 10m mark." },
    ],
  },
  {
    id: "badminton",
    name: "Badminton",
    category: "Main Sport",
    subCategory: "Indoor Court",
    tagline: "Smash Masters",
    dates: "5 Oct – 8 Oct 2026",
    players: "Single / Double",
    registrationFee: "Singles: 500 PKR (Male) / 300 PKR (Female) | Doubles: 1,000 PKR (Male) / 600 PKR (Female)",
    image: badmintonImg,
    badge: "MALE / FEMALE",
    rules: [
      { label: "Match Format", detail: "Qualifying & Simple matches are single set to 21 points (knockout)." },
      { label: "Semis & Finals", detail: "Semi-Finals and Finals played as Best of 3 sets to 21 points." },
      { label: "Set Cap & Extension", detail: "At 20-all, side gaining 2-point lead wins. Cap at 30 points (29-29 next point wins)." },
      { label: "Side Switch", detail: "Players switch sides after each set (and at 11 points in a third deciding set)." },
      { label: "Equipment", detail: "Shuttlecocks provided by organizers. Players must use standard badminton rackets." },
    ],
  },
  {
    id: "tabletennis",
    name: "Table Tennis",
    category: "Main Sport",
    subCategory: "Indoor",
    tagline: "Spin Warriors",
    dates: "5 Oct – 8 Oct 2026",
