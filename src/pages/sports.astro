      { label: "Game Format", detail: "12 players per game + 1 Host. Individual participation with secret roles." },
      { label: "Night Phase", detail: "Mafia eliminates 1 player; Doctor protects 1 player; Detective investigates 1 player; Psycho Civilian ability." },
      { label: "Day Phase", detail: "Players discuss and vote to eliminate 1 suspect. In case of tie, revote held; if still tied, no elimination." },
      { label: "Win Conditions", detail: "Mafia wins when Mafia count >= Town; Town wins when all Mafia eliminated; Jester wins if voted out on Day." },
      { label: "Secrecy & Host", detail: "Do not reveal role cards. Host manages all phases and decisions are final." },
