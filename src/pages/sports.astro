---

<Layout title="Sports Cards & Tournament Rules | FAST NUCES Peshawar Sports Society">
  <Navbar />
  <main class="pt-28 pb-24 bg-black text-white">
    
    <!-- Hero Header -->
    <div class="relative py-16 bg-gradient-to-b from-red-950/60 via-zinc-950 to-black border-b border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="px-4 py-1.5 bg-red-600 text-white font-bebas text-sm tracking-widest uppercase rounded-full shadow-lg">
          ATHLETIC DISCIPLINES & RULES
        </span>
        <h1 class="font-bebas text-6xl sm:text-8xl tracking-tight text-white mt-4">
          SPORTS CARDS & <span class="text-red-600">MATCH RULES</span>
        </h1>
        <p class="max-w-3xl mx-auto text-zinc-300 text-base sm:text-lg mt-4">
          Detailed sports cards, team captains, squad limits, match durations, and official tournament regulations.
        </p>
      </div>
    </div>

    <!-- Sports List Container -->
    <div id="rules" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
      
      {sportsWithRules.map((sport) => (
        <div class="p-6 sm:p-10 rounded-3xl bg-zinc-950 border border-zinc-800/80 hover:border-red-600/50 transition-all flex flex-col lg:flex-row gap-8 items-start">
          
          <!-- Image & Captain Details -->
          <div class="lg:w-1/3 w-full space-y-4">
            <div class="relative h-56 sm:h-64 w-full rounded-2xl overflow-hidden border border-zinc-800">
              <Image
                src={sport.image}
                alt={sport.name}
                class="w-full h-full object-cover filter brightness-90"
              />
              <span class="absolute top-3 left-3 px-3 py-1 bg-red-600/90 text-white rounded-full text-[10px] font-extrabold uppercase tracking-widest">
                {sport.badge}
              </span>
              <span class="absolute top-3 right-3 px-3 py-1 bg-black/80 text-zinc-300 border border-zinc-700 rounded-full text-[10px] font-bold uppercase tracking-widest">
                {sport.category}
              </span>
            </div>

            <div>
              <h3 class="font-bebas text-4xl text-white tracking-wide">{sport.name}</h3>
              <p class="text-xs font-bold text-red-500 uppercase tracking-widest mt-1">{sport.tagline}</p>
              <p class="text-xs text-zinc-400 font-mono mt-1">{sport.captain}</p>
            </div>
          </div>

          <!-- Official Rules Grid -->
          <div class="lg:w-2/3 w-full space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-widest text-red-400 font-mono pb-2 border-b border-zinc-800">
              Official Match Rules & Guidelines:
            </h4>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {sport.rules.map((rule) => (
                <div class="p-4 rounded-xl bg-zinc-900/70 border border-zinc-800/80">
                  <span class="text-xs font-bold uppercase tracking-wider text-red-400 block font-mono mb-1">
                    {rule.label}
                  </span>
                  <p class="text-xs text-zinc-300 leading-relaxed">
                    {rule.detail}
                  </p>
                </div>
              ))}
            </div>
          </div>

        </div>
      ))}

    </div>

  </main>
  <Footer />
</Layout>
