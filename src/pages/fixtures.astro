---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Sports Week Fixtures | FAST NUCES Peshawar Sports Society">
  <Navbar />
  <main class="pt-28 pb-24 bg-black text-white min-h-[80vh] flex flex-col justify-center items-center">
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center my-auto py-16">
      
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-950/80 border border-red-800/60 mb-6 shadow-lg shadow-red-950/50">
        <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-red-400 font-mono">
          Sports Week • 5 – 8 October 2026
        </span>
      </div>

      <h1 class="font-bebas text-6xl sm:text-8xl tracking-tight text-white mb-4">
        MATCH FIXTURES <span class="text-red-600">SCHEDULE</span>
      </h1>

      <!-- Stylized Notice Box -->
      <div class="p-8 sm:p-12 rounded-3xl bg-zinc-950 border border-zinc-800 shadow-2xl relative overflow-hidden my-8 max-w-2xl mx-auto">
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="w-16 h-16 rounded-2xl bg-zinc-900 border border-zinc-700 flex items-center justify-center mx-auto mb-6 text-red-500 shadow-inner">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>

        <h2 class="font-bebas text-3xl sm:text-4xl text-white tracking-wide mb-3">
          WILL BE UPDATED SOON
        </h2>

        <p class="text-zinc-400 text-sm sm:text-base leading-relaxed max-w-lg mx-auto font-medium">
          As we haven't finalized the fixtures yet, the official match schedules, draw brackets, and ground timings for Sports Week (5 – 8 October 2026) will be published here shortly.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-4 justify-center items-center">
        <a
          href="/sports"
          class="px-8 py-3.5 bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm tracking-widest uppercase rounded-full shadow-lg transition-all hover:scale-105"
        >
          Explore Sports & Rules
        </a>
        <a
          href="/teams"
          class="px-8 py-3.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 hover:text-white font-bold text-sm tracking-widest uppercase rounded-full border border-zinc-800 transition-all"
        >
          View Core Team
        </a>
      </div>

    </div>

  </main>
  <Footer />
</Layout>
