---

<Layout title="4-Day Event Sports Schedule | FAST NUCES Peshawar Sports Society">
  <Navbar />
  <main class="pt-28 pb-24 bg-black text-white">
    
    <!-- Hero Header -->
    <div class="relative py-16 bg-gradient-to-b from-red-950/60 via-zinc-950 to-black border-b border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="px-4 py-1.5 bg-red-600 text-white font-bebas text-sm tracking-widest uppercase rounded-full shadow-lg">
          ANNUAL SPORTS MEGA FESTIVAL
        </span>
        <h1 class="font-bebas text-6xl sm:text-8xl tracking-tight text-white mt-4">
          4-DAY EVENT <span class="text-red-600">FULL SPORTS SCHEDULE</span>
        </h1>
        <p class="max-w-3xl mx-auto text-zinc-300 text-base sm:text-lg mt-4">
          Complete day-by-day fixtures, timings, venues, and status for all sports disciplines at the FAST NUCES Peshawar Annual Sports Gala.
        </p>
      </div>
    </div>

    <!-- Featured Match Teaser -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <MatchFixtures />
    </div>

    <!-- Day By Day Full Schedule Section -->
    <div id="full-schedule" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      
      <!-- Day Tabs Navigation -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-12" id="day-tabs">
        <button data-target="all" class="tab-btn active px-6 py-3 rounded-full font-bebas text-xl tracking-wider uppercase transition-all bg-red-600 text-white shadow-lg">
          ALL 4 DAYS
        </button>
        <button data-target="Day 1" class="tab-btn px-6 py-3 rounded-full font-bebas text-xl tracking-wider uppercase transition-all bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800">
          DAY 1 (OCT 15)
        </button>
        <button data-target="Day 2" class="tab-btn px-6 py-3 rounded-full font-bebas text-xl tracking-wider uppercase transition-all bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800">
          DAY 2 (OCT 16)
        </button>
        <button data-target="Day 3" class="tab-btn px-6 py-3 rounded-full font-bebas text-xl tracking-wider uppercase transition-all bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800">
          DAY 3 (OCT 17)
        </button>
        <button data-target="Day 4" class="tab-btn px-6 py-3 rounded-full font-bebas text-xl tracking-wider uppercase transition-all bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800">
          DAY 4 (OCT 18)
        </button>
      </div>

      <!-- Schedule Content Cards -->
      <div class="space-y-12">
        {dayByDaySchedule.map((dayGroup) => (
          <div class="day-section bg-zinc-950 rounded-3xl p-6 sm:p-10 border border-zinc-800/80 shadow-2xl" data-day={dayGroup.day}>
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-zinc-800 gap-4">
              <div>
                <span class="text-xs font-bold uppercase tracking-widest text-red-500 block">
                  {dayGroup.dateLabel}
                </span>
                <h2 class="font-bebas text-3xl sm:text-4xl text-white tracking-wide mt-1">
                  {dayGroup.dayTitle}
                </h2>
              </div>
              <span class="px-4 py-1.5 bg-red-950/80 border border-red-800/60 text-red-300 font-bebas text-lg rounded-full w-fit">
                4 MATCHES SCHEDULED
              </span>
            </div>

            <!-- Matches List Table/Cards -->
            <div class="grid grid-cols-1 gap-4">
              {dayGroup.matches.map((m) => (
                <div class="p-5 sm:p-6 rounded-2xl bg-zinc-900/60 border border-zinc-800 hover:border-red-600/50 transition-all flex flex-col md:flex-row md:items-center justify-between gap-4 group">
                  
                  <div class="flex items-start gap-4">
                    <div class="px-4 py-3 bg-black rounded-xl border border-zinc-800 text-center min-w-[130px]">
                      <span class="text-xs font-bold uppercase tracking-wider text-red-400 block font-mono">TIME</span>
                      <span class="text-sm font-extrabold text-white">{m.time}</span>
                    </div>

                    <div>
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="px-2.5 py-0.5 rounded text-[10px] font-extrabold uppercase tracking-wider bg-red-600/20 text-red-400 border border-red-900/50">
                          {m.sport}
                        </span>
                        <span class="text-xs text-zinc-500 font-mono">
                          {m.category}
                        </span>
                      </div>

                      <h3 class="font-bebas text-2xl text-white tracking-wide mt-1 group-hover:text-red-500 transition-colors">
                        {m.matchName}
                      </h3>

                      <p class="text-xs text-zinc-400 mt-1">
                        📍 Venue: <strong class="text-zinc-200">{m.venue}</strong> • Format: {m.teams}
                      </p>
                    </div>
                  </div>

                  <div class="flex items-center gap-3 self-end md:self-center">
                    <span class="px-4 py-1.5 rounded-full bg-zinc-950 border border-zinc-700 text-xs font-bold text-zinc-300 uppercase tracking-widest">
                      {m.status}
                    </span>
                  </div>

                </div>
              ))}
            </div>

          </div>
        ))}
      </div>

    </div>

  </main>
  <Footer />
</Layout>

<script>
  const tabBtns = document.querySelectorAll(".tab-btn");
  const daySections = document.querySelectorAll(".day-section");

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      tabBtns.forEach((b) => {
        b.classList.remove("bg-red-600", "text-white", "shadow-lg");
        b.classList.add("bg-zinc-900", "text-zinc-400");
      });
      btn.classList.remove("bg-zinc-900", "text-zinc-400");
      btn.classList.add("bg-red-600", "text-white", "shadow-lg");

      const target = btn.getAttribute("data-target");

      daySections.forEach((section) => {
        if (target === "all" || section.getAttribute("data-day") === target) {
          (section as HTMLElement).style.display = "block";
        } else {
          (section as HTMLElement).style.display = "none";
        }
      });
    });
  });
</script>
