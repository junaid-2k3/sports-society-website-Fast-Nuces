---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Contact Us & Web Developer Intro | FAST NUCES Peshawar Sports Society">
  <Navbar />
  <main class="pt-28 pb-24 bg-black text-white">
    
    <!-- Hero Header -->
    <div class="relative py-16 bg-gradient-to-b from-red-950/60 via-zinc-950 to-black border-b border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="px-4 py-1.5 bg-red-600 text-white font-bebas text-sm tracking-widest uppercase rounded-full shadow-lg">
          OFFICE CONTACT & CREATOR PROFILE
        </span>
        <h1 class="font-bebas text-6xl sm:text-8xl tracking-tight text-white mt-4">
          CONTACT US & <span class="text-red-600">THE DEVELOPER</span>
        </h1>
        <p class="max-w-3xl mx-auto text-zinc-300 text-base sm:text-lg mt-4">
          Reach out to the FAST NUCES Peshawar Sports Society Office or connect with the Lead Website Designer & Developer.
        </p>
      </div>
    </div>

    <!-- SECTION 1: INTRO ABOUT ME (WEBSITE DESIGNER & DEV - JUNAID) -->
    <div id="developer" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-b border-zinc-900">
      <div class="relative rounded-3xl p-8 sm:p-12 bg-gradient-to-br from-zinc-950 via-zinc-900 to-red-950/40 border border-red-600/50 shadow-2xl overflow-hidden">
        
        <div class="absolute -right-20 -top-20 w-80 h-80 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
          
          <!-- Avatar & Badge -->
          <div class="lg:col-span-4 flex flex-col items-center text-center">
            <div class="relative w-40 h-40 rounded-full bg-black p-2 border-4 border-red-600 shadow-2xl mb-4 group overflow-hidden">
              <img
                src="/logos/sports_society_logo.png"
                alt="Junaid - Website Designer and Developer"
                class="w-full h-full object-contain filter drop-shadow group-hover:scale-110 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-red-600/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>

            <span class="px-4 py-1 bg-red-600 text-white font-bebas text-sm tracking-widest uppercase rounded-full shadow-md">
              CREATOR & ENGINEER
            </span>

            <h3 class="font-bebas text-4xl text-white tracking-wide mt-3 mb-1">
              JUNAID
            </h3>
            
            <p class="text-xs font-bold uppercase tracking-widest text-red-400">
              Website Designer & Full-Stack Developer
            </p>
            
            <p class="text-xs text-zinc-400 font-mono mt-1">
              FAST NUCES Peshawar Campus
            </p>
          </div>

          <!-- Developer Bio & Tech Specs -->
          <div class="lg:col-span-8 space-y-5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-red-950/80 border border-red-800/60">
              <span class="text-xs font-bold uppercase tracking-widest text-red-300">About The Developer</span>
            </div>

            <h2 class="font-bebas text-4xl sm:text-5xl text-white tracking-tight leading-none">
              CRAFTING THE DIGITAL VOICE OF <span class="text-red-500">FAST CYCLONES</span>
            </h2>

            <p class="text-zinc-300 text-sm sm:text-base leading-relaxed">
              Hello! I'm <strong class="text-white font-semibold">Junaid</strong>, the website designer and software developer behind the official FAST NUCES Peshawar Sports Society Web Application. Built with passion for high performance, dynamic athletic styling, and seamless user experiences, this platform serves 1,000+ students across all 9 sports disciplines.
            </p>

            <!-- Tech Stack Pills -->
            <div>
              <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-400 mb-2">Tech Stack & Engineering Highlights:</h4>
              <div class="flex flex-wrap gap-2 text-xs font-mono">
                <span class="px-3 py-1 bg-black rounded-lg border border-zinc-800 text-zinc-300">⚡ Astro 5 SSG</span>
                <span class="px-3 py-1 bg-black rounded-lg border border-zinc-800 text-zinc-300">🎨 Vanilla CSS & Modern Styling</span>
                <span class="px-3 py-1 bg-black rounded-lg border border-zinc-800 text-zinc-300">🚀 Ultra-Fast CWV Performance</span>
                <span class="px-3 py-1 bg-black rounded-lg border border-zinc-800 text-zinc-300">📱 Mobile-First Responsive</span>
                <span class="px-3 py-1 bg-black rounded-lg border border-zinc-800 text-zinc-300">🔥 Bebas Neue & Inter Typography</span>
              </div>
            </div>

            <!-- Direct Contact & Social Links -->
            <div class="pt-4 border-t border-zinc-800 flex flex-wrap items-center gap-4">
              <a
                href="mailto:p230123@nu.edu.pk"
                class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-bold text-xs uppercase tracking-widest rounded-full shadow-lg transition-all"
              >
                Connect With Junaid
              </a>
              <span class="text-xs text-zinc-400 font-mono">
                Official Developer Contact: <strong class="text-zinc-200">sports.society@nu.edu.pk</strong>
              </span>
            </div>

          </div>

        </div>

      </div>
    </div>

    <!-- SECTION 2: CONTACT OFFICE & MESSAGE FORM -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Contact Details -->
        <div class="lg:col-span-5 space-y-8">
          <div class="p-8 rounded-3xl bg-zinc-950 border border-zinc-800 space-y-6">
            <h3 class="font-bebas text-3xl text-white tracking-wide">SPORTS SOCIETY OFFICE</h3>
            
            <div class="space-y-4 text-sm text-zinc-300">
              <div class="flex items-start gap-4">
                <span class="text-2xl">📍</span>
                <div>
                  <strong class="text-white block">Campus Location:</strong>
                  FAST NUCES Peshawar Campus, 160 Industrial Estate, Jamrud Road, Peshawar, KP.
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="text-2xl">📞</span>
                <div>
                  <strong class="text-white block">Phone / UAN:</strong>
                  +92 (91) 111 128 128 (Ext. 140 - Sports Office)
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="text-2xl">✉️</span>
                <div>
                  <strong class="text-white block">Email Address:</strong>
                  sports.society@nu.edu.pk
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="text-2xl">⏰</span>
                <div>
                  <strong class="text-white block">Office Hours:</strong>
                  Monday - Friday: 09:00 AM - 05:00 PM PST
                </div>
              </div>
            </div>
          </div>

          <!-- Social Channels Card -->
          <div class="p-8 rounded-3xl bg-gradient-to-br from-red-950 to-zinc-950 border border-red-900/50">
            <h4 class="font-bebas text-2xl text-white tracking-wide mb-2">JOIN OUR ONLINE COMMUNITY</h4>
            <p class="text-xs text-zinc-300 mb-6">Stay updated with live score announcements, trial dates, and sports gala updates.</p>
            
            <div class="flex flex-wrap gap-3">
              <a href="#" class="px-5 py-2.5 rounded-full bg-red-600 hover:bg-red-700 text-white font-bold text-xs uppercase tracking-wider transition-all">
                WhatsApp Channel
              </a>
              <a href="#" class="px-5 py-2.5 rounded-full bg-zinc-800 hover:bg-zinc-700 text-white font-bold text-xs uppercase tracking-wider transition-all">
                Instagram Page
              </a>
              <a href="#" class="px-5 py-2.5 rounded-full bg-zinc-800 hover:bg-zinc-700 text-white font-bold text-xs uppercase tracking-wider transition-all">
                Discord Community
              </a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-7">
          <div class="p-8 sm:p-10 rounded-3xl bg-zinc-950 border border-zinc-800">
            <h3 class="font-bebas text-4xl text-white tracking-wide mb-2">SEND US A MESSAGE</h3>
            <p class="text-xs text-zinc-400 mb-6">Fill out the form below and our Executive Board or Web Developer will get back to you within 24 hours.</p>

            <form class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-1">Your Name</label>
                  <input type="text" required placeholder="e.g. Ali Raza" class="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-800 text-white focus:outline-none focus:border-red-600" />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-1">Student Roll No / Email</label>
                  <input type="text" required placeholder="p230123@nu.edu.pk" class="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-800 text-white focus:outline-none focus:border-red-600" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-1">Subject / Query Type</label>
                <select class="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-800 text-white focus:outline-none focus:border-red-600">
                  <option value="trials">Squad Trials Inquiry</option>
                  <option value="gala">4-Day Sports Gala Query</option>
                  <option value="developer">Website Feedback for Developer (Junaid)</option>
                  <option value="sponsorship">Sponsorship & Partnership</option>
                  <option value="general">General Inquiry</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-1">Message</label>
                <textarea rows="4" required placeholder="Write your message here..." class="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-800 text-white focus:outline-none focus:border-red-600"></textarea>
              </div>

              <button type="submit" class="w-full py-4 bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm uppercase tracking-widest rounded-xl transition-all shadow-lg">
                Send Message
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>

    <!-- Fan Code of Conduct Section -->
    <div id="code" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-zinc-900">
      <div class="p-8 sm:p-12 rounded-3xl bg-zinc-950 border border-red-900/40">
        <span class="text-xs font-bold uppercase tracking-widest text-red-500">GROUND RULES</span>
        <h2 class="font-bebas text-5xl text-white tracking-wide mt-1 mb-6">FASTIAN FAN CODE OF CONDUCT</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-zinc-300">
          <div class="p-6 rounded-2xl bg-black/60 border border-zinc-800">
            <h4 class="font-bebas text-2xl text-white tracking-wider mb-2">1. RESPECT ATHLETES & REFEREES</h4>
            <p class="text-xs leading-relaxed text-zinc-400">We cheer passionately for FAST NUCES while maintaining utter respect for all student athletes and match officials.</p>
          </div>
          <div class="p-6 rounded-2xl bg-black/60 border border-zinc-800">
            <h4 class="font-bebas text-2xl text-white tracking-wider mb-2">2. LOUD, POSITIVE SUPPORT</h4>
            <p class="text-xs leading-relaxed text-zinc-400">Bring maximum energy, chants, and drums. Discriminatory or abusive language is strictly prohibited.</p>
          </div>
          <div class="p-6 rounded-2xl bg-black/60 border border-zinc-800">
            <h4 class="font-bebas text-2xl text-white tracking-wider mb-2">3. KEEP GROUNDS CLEAN</h4>
            <p class="text-xs leading-relaxed text-zinc-400">Respect our campus sports complex. Dispose of trash in designated bins after every match day.</p>
          </div>
        </div>
      </div>
    </div>

  </main>
  <Footer />
</Layout>
