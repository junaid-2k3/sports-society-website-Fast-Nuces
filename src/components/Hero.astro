---
import { Image } from "astro:assets";
import heroImg from "../assets/home poster.jpg";
---

<section class="relative min-h-[85vh] w-full flex flex-col justify-between overflow-hidden pt-24 bg-black">
  <!-- Background Sports Image -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroImg}
      alt="FAST NUCES Peshawar Sports Stadium"
      class="w-full h-full object-cover object-center filter brightness-[0.4] contrast-110"
      loading="eager"
    />
  </div>

  <div class="absolute inset-0 z-10 bg-gradient-to-t from-black via-black/60 to-black/80"></div>

  <!-- Hero Main Content -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-auto text-center flex flex-col items-center py-16">
    
    <span class="text-xs font-bold uppercase tracking-widest text-red-500 mb-4 font-mono">
      FAST NUCES Peshawar Sports Portal • 5 - 8 October 2026
    </span>

    <h1 class="font-bebas text-6xl sm:text-8xl md:text-9xl tracking-tighter leading-none text-white">
      <span class="block text-zinc-300 uppercase tracking-widest text-3xl sm:text-5xl md:text-6xl mb-1">FAST NUCES PESHAWAR</span>
      <span class="block text-red-600">THE CYCLONES</span>
    </h1>

    <p class="mt-6 max-w-2xl text-base sm:text-lg md:text-xl text-zinc-300 font-medium leading-relaxed">
      We bring the noise. We bring the passion.<br />
      The official athletic portal for FAST NUCES Peshawar Sports Week (5 – 8 Oct 2026), rules, and core team.
    </p>

    <div class="mt-10 flex flex-wrap gap-4 justify-center items-center">
      <a
        href="https://forms.gle/MqXNNPWHjV4oW2bP7"
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-3.5 bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm tracking-wider uppercase rounded-xl transition-all shadow-lg shadow-red-950/80 hover:scale-105 flex items-center gap-2"
      >
        <span>Register Now</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <a
        href="/fixtures"
        class="px-8 py-3.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 hover:text-white font-bold text-sm tracking-wider uppercase rounded-xl border border-zinc-700 transition-all"
      >
        View Event Schedule
      </a>
      <a
        href="/sports"
        class="px-8 py-3.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 hover:text-white font-bold text-sm tracking-wider uppercase rounded-xl border border-zinc-700 transition-all"
      >
        Explore Sports & Rules
      </a>
    </div>

  </div>

  <!-- Bottom Stats Strip -->
  <div class="relative z-20 w-full bg-zinc-950/90 border-t border-zinc-800 py-4 px-4">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-around gap-6 text-center text-xs font-mono text-zinc-400">
      <div><strong class="text-white text-base font-bebas block text-red-500">5 - 8 OCT 2026</strong> Sports Week</div>
      <div><strong class="text-white text-base font-bebas block text-red-500">13 SPORTS</strong> Disciplines & Rules</div>
      <div><strong class="text-white text-base font-bebas block text-red-500">500+ ATHLETES</strong> Campus Competitors</div>
      <div><strong class="text-white text-base font-bebas block text-red-500">CORE TEAM</strong> Student Leadership</div>
    </div>
  </div>
</section>