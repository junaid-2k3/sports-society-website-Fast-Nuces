---
const navCards = [
  {
    title: "4-Day Event Fixtures",
    category: "Schedule",
    desc: "Day 1 to Day 4 match schedules, timings, grounds, and match formats.",
    link: "/fixtures",
    cta: "View Fixtures",
  },
  {
    title: "Sports Cards & Rules",
    category: "Disciplines",
    desc: "Complete list of 9+ sports cards along with match rules, team sizes, and scoring.",
    link: "/sports",
    cta: "Explore Sports & Rules",
  },
  {
    title: "Core Team & Leadership",
    category: "Leadership",
    desc: "Faculty advisors, executive board cabinet, and discipline heads roster.",
    link: "/teams",
    cta: "Meet Core Team",
  },
  {
    title: "Contact Office & Dev Intro",
    category: "Office & Dev",
    desc: "Contact FAST sports office or meet Junaid, the lead website designer & dev.",
    link: "/contact",
    cta: "Contact & Developer",
  },
];
---

<section class="py-20 bg-black relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-red-500 font-mono">Direct Navigation</span>
      <h2 class="font-bebas text-4xl sm:text-6xl text-white tracking-tight mt-1">
        QUICK <span class="text-red-600">PAGES ACCESS</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {navCards.map((card) => (
        <a
          href={card.link}
          class="group relative overflow-hidden p-6 rounded-2xl border border-zinc-800 hover:border-red-600 transition-all flex flex-col justify-between bg-zinc-950/80"
        >
          <div class="absolute inset-0">
            <img src="/background/background3.jpeg" alt="Direct navigation background" class="h-full w-full object-cover opacity-35" />
          </div>
          <div class="absolute inset-0 bg-black/55"></div>

          <div class="relative z-10 flex flex-col h-full justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-widest text-red-500 block mb-2">
                {card.category}
              </span>
              <h3 class="font-bebas text-2xl text-white tracking-wide group-hover:text-red-500 transition-colors mb-2">
                {card.title}
              </h3>
              <p class="text-xs text-zinc-300 leading-relaxed mb-6">
                {card.desc}
              </p>
            </div>

            <div class="pt-4 border-t border-zinc-700/70 flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-zinc-200 group-hover:text-white transition-colors">
                {card.cta}
              </span>
              <span class="text-red-500 group-hover:translate-x-1 transition-transform text-sm">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
