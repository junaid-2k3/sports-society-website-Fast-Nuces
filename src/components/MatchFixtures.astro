---
---

<section id="fixtures" class="py-20 bg-zinc-950 border-t border-b border-zinc-800 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="p-8 sm:p-12 rounded-3xl bg-black border border-zinc-800 shadow-2xl relative overflow-hidden text-center max-w-4xl mx-auto">
      <div class="absolute -top-20 -left-20 w-40 h-40 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -right-20 w-40 h-40 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-950/80 border border-red-800/60 mb-4">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-red-400">Sports Week • 5 – 8 October 2026</span>
      </div>

      <h2 class="font-bebas text-4xl sm:text-6xl tracking-tight text-white mb-3">
        MATCH FIXTURES <span class="text-red-600">WILL BE UPDATED SOON</span>
      </h2>

      <p class="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto mb-8 font-medium">
        We haven't finalized the official fixtures and match brackets yet for Sports Week (5 – 8 Oct 2026). Check back soon for full schedules and court assignments.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/fixtures"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold text-xs tracking-widest uppercase rounded-full transition-all hover:scale-105 shadow-lg shadow-red-950/50"
        >
          <span>Check Fixtures Updates</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="/sports"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 font-bold text-xs tracking-widest uppercase rounded-full border border-zinc-700 transition-all"
        >
          <span>Explore Sports & Rules</span>
        </a>
      </div>
    </div>

  </div>
</section>
