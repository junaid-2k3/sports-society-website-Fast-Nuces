---

<footer class="bg-black text-zinc-400 border-t border-zinc-800 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Brand & Logos -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img src="/logos/website_favicon.png" alt="FAST Peshawar Sports Logo" class="h-12 w-auto object-contain" />
          <div class="h-8 w-px bg-zinc-800"></div>
          <img src="/logos/fast_nu_full_log.png" alt="FAST NUCES Logo" class="h-10 w-auto object-contain brightness-200" />
        </div>

        <h3 class="font-bebas text-2xl text-white tracking-wider">
          FAST NUCES PESHAWAR SPORTS SOCIETY
        </h3>

        <p class="text-xs text-zinc-400 max-w-sm leading-relaxed">
          The official student section and athletic society of FAST NUCES Peshawar. We foster championship sportsmanship, health, and unmatched student section energy.
        </p>

        <p class="text-xs text-red-500 font-bold uppercase tracking-widest">
          WE BRING THE NOISE. WE BRING THE PASSION.
        </p>
      </div>

      <!-- Quick Navigation Links -->
      <div>
        <h4 class="font-bebas text-xl text-white tracking-wider mb-4">NAVIGATION</h4>
        <ul class="space-y-2.5 text-xs font-medium">
          <li><a href="/" class="hover:text-red-500 transition-colors">Home</a></li>
          <li><a href="/fixtures" class="hover:text-red-500 transition-colors">4-Day Fixtures</a></li>
          <li><a href="/sports" class="hover:text-red-500 transition-colors">Sports & Rules</a></li>
          <li><a href="/teams" class="hover:text-red-500 transition-colors">Core Team</a></li>
          <li><a href="/gallery" class="hover:text-red-500 transition-colors">Photo Vault & Gallery</a></li>
          <li><a href="/contact" class="hover:text-red-500 transition-colors">Contact Us & Dev Intro</a></li>
        </ul>
      </div>

      <!-- Information & Guidelines -->
      <div>
        <h4 class="font-bebas text-xl text-white tracking-wider mb-4">INFORMATION</h4>
        <ul class="space-y-2.5 text-xs font-medium">
          <li><a href="/contact#code" class="hover:text-red-500 transition-colors">Fan Code of Conduct</a></li>
          <li><a href="/sports#rules" class="hover:text-red-500 transition-colors">Official Sports Rules</a></li>
          <li><a href="/contact#developer" class="hover:text-red-500 transition-colors">About Web Developer</a></li>
          <li><a href="/contact" class="hover:text-red-500 transition-colors">Contact Sports Office</a></li>
          <li><a href="/contact#map" class="hover:text-red-500 transition-colors">Sports Ground Map</a></li>
        </ul>
      </div>

      <!-- Contact & Address -->
      <div>
        <h4 class="font-bebas text-xl text-white tracking-wider mb-4">CAMPUS ADDRESS</h4>
        <div class="text-xs space-y-2 text-zinc-400">
          <p class="text-zinc-200 font-semibold">FAST NUCES Peshawar Campus</p>
          <p>160 Industrial Estate, Jamrud Road,</p>
          <p>Peshawar, Khyber Pakhtunkhwa, Pakistan</p>
          <p class="pt-2">📞 UAN: +92 (91) 111 128 128</p>
          <p>✉️ sports.society@nu.edu.pk</p>
        </div>
      </div>

    </div>

    <!-- MUSS Style Footer Sub-Bar -->
    <div class="mt-16 pt-8 border-t border-zinc-900 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-zinc-500">
      <div class="flex items-center gap-6 flex-wrap justify-center">
        <a href="/contact#code" class="hover:text-zinc-300 transition-colors">Code of Conduct</a>
        <span>•</span>
        <a href="/contact" class="hover:text-zinc-300 transition-colors">Contact Office</a>
        <span>•</span>
        <a href="https://pwr.nu.edu.pk" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-300 transition-colors">About FAST Peshawar</a>
      </div>

      <div class="text-center md:text-right">
        <p>© 2026 FAST NUCES Peshawar Sports Society. All rights reserved.</p>
        <p class="text-[10px] text-zinc-400 mt-0.5 font-mono">Designed & Built by <span class="text-red-400 font-bold">Junaid</span> (Web Designer & Dev).</p>
      </div>
    </div>
  </div>
</footer>
