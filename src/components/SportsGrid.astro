---
import { Image } from "astro:assets";

import cricketImg from "../assets/pexels-gergo-8331954-7625920.jpg";
import footballImg from "../assets/pexels-jean-daniel-15964698.jpg";
import basketballImg from "../assets/pexels-jean-daniel-14690053.jpg";
import volleyballImg from "../assets/pexels-princeton-dsouza-2151536107-31723744.jpg";
import badmintonImg from "../assets/pexels-princeton-dsouza-2151536107-31723741.jpg";
import ttImg from "../assets/pexels-miguel-guerra-3200843-38761707.jpg";
import esportsImg from "../assets/pexels-mateo-franciosi-283676800-39356403.jpg";
import athleticsImg from "../assets/pexels-konrads-photo-32681168.jpg";
import chessImg from "../assets/pexels-konrads-photo-32681154.jpg";

const sports = [
  {
    name: "Cricket",
    tagline: "The Fastian XI",
    teamCaptain: "Captain: Hamza Khan (CS '23)",
    achievements: "FAST Gala Champions",
    image: cricketImg,
    badge: "MEN & WOMEN",
  },
  {
    name: "Football",
    tagline: "Red Cyclones FC",
    teamCaptain: "Captain: Shahzar Afridi (SE '23)",
    achievements: "Inter-FAST Gold Medalists",
    image: footballImg,
    badge: "MEN's SQUAD",
  },
  {
    name: "Basketball",
    tagline: "FAST Hoopers",
    teamCaptain: "Captain: Bilal Ahmad (EE '24)",
    achievements: "Campus Cup Winners",
    image: basketballImg,
    badge: "MEN & WOMEN",
  },
  {
    name: "Volleyball",
    tagline: "Spikers Elite",
    teamCaptain: "Captain: Usman Shinwari (CS '24)",
    achievements: "Gala Champions 2025",
    image: volleyballImg,
    badge: "MEN'S SQUAD",
  },
  {
    name: "Badminton",
    tagline: "Smash Masters",
    teamCaptain: "Captain: Ayesha Gul (AI '24)",
    achievements: "Doubles Gold Champions",
    image: badmintonImg,
    badge: "MIXED DOUBLES",
  },
  {
    name: "Table Tennis",
    tagline: "Spin Warriors",
    teamCaptain: "Captain: Daniyal Shah (DS '25)",
    achievements: "Campus Singles Champions",
    image: ttImg,
    badge: "SINGLES & DOUBLES",
  },
  {
    name: "E-Sports Gaming",
    tagline: "FAST Cyber Cyclones",
    teamCaptain: "Captain: Rayan Khattak (Cyber '24)",
    achievements: "Valorant & FIFA Trophy",
    image: esportsImg,
    badge: "CYBER DIVISION",
  },
  {
    name: "Athletics & Track",
    tagline: "Peshawar Sprinters",
    teamCaptain: "Captain: Zubair Malik (CS '23)",
    achievements: "100m & 400m Gold Winners",
    image: athleticsImg,
    badge: "TRACK & FIELD",
  },
  {
    name: "Chess & Mind Sports",
    tagline: "Grandmasters Society",
    teamCaptain: "Captain: Sara Paracha (AI '25)",
    achievements: "FAST Rapid Champions",
    image: chessImg,
    badge: "MIND SPORTS",
  },
];
---

<section id="teams" class="py-24 bg-black relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-950/80 border border-red-800/60 mb-3">
        <span class="text-xs font-bold uppercase tracking-widest text-red-400">Athletic Disciplines</span>
      </div>
      <h2 class="font-bebas text-5xl sm:text-7xl tracking-tight text-white">
        SPORTS & <span class="text-red-600">DISCIPLINE CARDS</span>
      </h2>
      <p class="text-zinc-400 text-base sm:text-lg">
        Explore our official FAST NUCES Peshawar athletic disciplines, team captains, and tournament rules.
      </p>
    </div>

    <!-- Sports Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sports.map((sport) => (
        <div class="group relative rounded-3xl overflow-hidden bg-zinc-950 border border-zinc-800 hover:border-red-600/70 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-red-950/50 flex flex-col">
          
          <!-- Image Container -->
          <div class="relative h-64 w-full overflow-hidden">
            <Image
              src={sport.image}
              alt={sport.name}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 filter brightness-90 group-hover:brightness-100"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
            
            <span class="absolute top-4 left-4 px-3 py-1 bg-red-600/90 backdrop-blur-md text-white rounded-full text-[10px] font-extrabold uppercase tracking-widest">
              {sport.badge}
            </span>
          </div>

          <!-- Content -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-1">
                <h3 class="font-bebas text-4xl text-white tracking-wide group-hover:text-red-500 transition-colors">
                  {sport.name}
                </h3>
                <span class="text-xs font-bold text-red-400 uppercase tracking-widest">{sport.tagline}</span>
              </div>
              
              <p class="text-xs font-medium text-zinc-400 mb-4">
                🏆 {sport.achievements}
              </p>
              
              <p class="text-xs text-zinc-500 font-mono">
                {sport.teamCaptain}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-zinc-800 flex items-center justify-between">
              <a
                href="/sports"
                class="text-xs font-extrabold uppercase tracking-widest text-zinc-300 group-hover:text-red-500 transition-colors inline-flex items-center gap-1"
              >
                <span>Read Sports Rules & Format</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
